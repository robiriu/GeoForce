# GeoForce v2.0 environment template
# Copy to .env and fill in real values. .env is gitignored.

# ─── LLM provider (orchestrator) ───────────────────────────────────────────
# 'vertex' (default) uses Vertex AI Gemini via the GenAI App Builder credit.
# 'litellm' falls back to OpenRouter free models if Vertex credit is exhausted.
LLM_PROVIDER=vertex

# ─── Vertex AI Gemini (LLM_PROVIDER=vertex) ────────────────────────────────
# Path to the Vertex service-account JSON key. Must be gitignored.
GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/.gcp/geoforce-sa.json
GCP_PROJECT=forcex-studio
GCP_LOCATION=asia-southeast1
# Available models on this project (smoke-tested 2026-05-03):
#   asia-southeast1: gemini-2.5-flash
#   us-central1:     gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash
# Disable Gemini 2.5 thinking tokens for low-latency orchestrator turns (0 to disable).
# Set higher (e.g. 1024) when you want deeper reasoning (e.g. physics audits).
GEMINI_THINKING_BUDGET=0

# ─── OpenRouter fallback (LLM_PROVIDER=litellm) ────────────────────────────
# Only required if LLM_PROVIDER=litellm.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat:free

# ─── Legacy (v0.2 hackathon build, kept for reference and main-branch ops) ─
ANTHROPIC_API_KEY=
